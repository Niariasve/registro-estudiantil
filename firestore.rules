rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas de seguridad para el Registro Estudiantil
    // Permiten lectura y escritura pública para las colecciones necesarias.
    
    match /students/{studentId} {
      allow read, write: if true;
    }
    
    match /classes/{classId} {
      allow read, write: if true;
    }
    
    match /grades/{gradeId} {
      allow read, write: if true;
    }
    
    match /config/global {
      allow read, write: if true;
    }
  }
}
